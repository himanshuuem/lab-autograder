# Copy to .env (`make init` does this and fills in random secrets).

# Dashboard login
ADMIN_USER=ta
ADMIN_PASSWORD=

# Where the dashboard listens. 127.0.0.1 = this computer only.
# Use 0.0.0.0 to reach it from other machines on the department network.
APP_BIND=127.0.0.1
APP_PORT=8000
# Set to 1 when serving over HTTPS (behind a reverse proxy)
COOKIE_SECURE=0
# Public address for the built-in HTTPS proxy (scripts/server_setup.sh sets it)
DOMAIN=

# Sign in with Google: each teacher uses their own college account and sees only their
# own classes. Leave GOOGLE_CLIENT_ID empty for a single-teacher setup (token.json).
# Make the OAuth client in the college's Google Cloud project (README, "Sharing with colleagues").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The address teachers open; Google sends them back to PUBLIC_URL/api/auth/google/callback
PUBLIC_URL=http://localhost:8000
# Only accounts from this domain can sign in
ALLOWED_DOMAIN=college.ac.in
# Admins (comma-separated): they approve colleagues and can see every course
ADMIN_EMAILS=
# approve = a new teacher waits for an admin; open = anyone from ALLOWED_DOMAIN gets in
SIGNUP=approve
# 1 = keep the ADMIN_USER / ADMIN_PASSWORD form (always an admin); 0 = Google only
LOCAL_LOGIN=1

# demo = built-in sample course; google = your real Google Classroom
CLASSROOM_MODE=demo
# Folder holding credentials.json / token.json for Google (absolute path if Jenkins deploys)
SECRETS_DIR=./secrets

# How many students are graded at once
GRADING_WORKERS=4
SANDBOX_MAX_CONCURRENT=4

# Internal secrets (random; never shared with students)
SECRET_KEY=
POSTGRES_PASSWORD=
MCP_TOKEN=
SANDBOX_TOKEN=

# Jenkins (only with `make up-ci`)
JENKINS_PORT=8081
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=
